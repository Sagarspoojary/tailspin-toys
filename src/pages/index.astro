---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllCategories, getAllGames, getAllPublishers } from '../lib/games';

export const prerender = true;

const games = await getAllGames(getDatabase());
const categories = await getAllCategories(getDatabase());
const publishers = await getAllPublishers(getDatabase());
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div class="mb-8 rounded-2xl border border-slate-700 bg-slate-800/60 p-5 shadow-lg" data-testid="game-filters">
      <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <h2 id="filter-heading" class="text-xl font-semibold text-slate-100">Filter games</h2>
          <p class="mt-1 text-sm text-slate-400">Narrow the catalog by category, publisher, or both.</p>
        </div>

        <button
          type="button"
          class="rounded-full border border-slate-600 bg-slate-700 px-4 py-2 text-sm font-medium text-slate-100 transition-colors hover:bg-slate-600 focus:ring-2 focus:ring-blue-500 focus:outline-none"
          data-testid="clear-filters"
        >
          Clear filters
        </button>
      </div>

      <div class="mt-5 grid gap-5 md:grid-cols-2">
        <fieldset aria-labelledby="category-filter-heading" class="rounded-xl border border-slate-700 bg-slate-900/40 p-4">
          <legend id="category-filter-heading" class="text-sm font-medium text-slate-200">Categories</legend>
          <div class="mt-3 flex flex-wrap gap-2" role="group" aria-label="Filter games by category">
            {categories.map((category) => (
              <label
                for={`category-${category.id}`}
                class="inline-flex cursor-pointer items-center gap-2 rounded-full border border-slate-600 bg-slate-800 px-3 py-2 text-sm text-slate-200 transition-colors hover:border-blue-500 hover:text-blue-200"
                data-testid={`category-filter-label-${category.id}`}
              >
                <input
                  id={`category-${category.id}`}
                  type="checkbox"
                  value={category.name}
                  data-filter-type="category"
                  data-testid={`category-filter-${category.id}`}
                  class="h-4 w-4 rounded border-slate-600 bg-slate-900 text-blue-500 focus:ring-2 focus:ring-blue-400 focus:ring-offset-0 focus:ring-offset-slate-800"
                />
                <span>{category.name}</span>
              </label>
            ))}
          </div>
        </fieldset>

        <fieldset aria-labelledby="publisher-filter-heading" class="rounded-xl border border-slate-700 bg-slate-900/40 p-4">
          <legend id="publisher-filter-heading" class="text-sm font-medium text-slate-200">Publishers</legend>
          <div class="mt-3 flex flex-wrap gap-2" role="group" aria-label="Filter games by publisher">
            {publishers.map((publisher) => (
              <label
                for={`publisher-${publisher.id}`}
                class="inline-flex cursor-pointer items-center gap-2 rounded-full border border-slate-600 bg-slate-800 px-3 py-2 text-sm text-slate-200 transition-colors hover:border-purple-500 hover:text-purple-200"
                data-testid={`publisher-filter-label-${publisher.id}`}
              >
                <input
                  id={`publisher-${publisher.id}`}
                  type="checkbox"
                  value={publisher.name}
                  data-filter-type="publisher"
                  data-testid={`publisher-filter-${publisher.id}`}
                  class="h-4 w-4 rounded border-slate-600 bg-slate-900 text-purple-500 focus:ring-2 focus:ring-purple-400 focus:ring-offset-0 focus:ring-offset-slate-800"
                />
                <span>{publisher.name}</span>
              </label>
            ))}
          </div>
        </fieldset>
      </div>
    </div>

    <div>
      <h2 class="text-2xl font-medium mb-6 text-slate-100">Featured Games</h2>

      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" data-testid="games-grid">
            {games.map((game) => <GameCard game={game} />)}
          </div>

          <div
            class="mt-6 hidden rounded-xl border border-slate-700 bg-slate-800/60 p-4 text-center text-slate-200"
            data-testid="filter-empty-state"
            role="status"
            aria-live="polite"
            hidden
          >
            No games match the selected filters.
          </div>
        </>
      )}
    </div>
  </div>

  <script is:inline>
    const filterInputs = Array.from(document.querySelectorAll('input[data-filter-type]'));
    const gameCards = Array.from(document.querySelectorAll('[data-testid="game-card"]'));
    const clearFiltersButton = document.querySelector('[data-testid="clear-filters"]');
    const emptyState = document.querySelector('[data-testid="filter-empty-state"]');

    const getSelectedValues = (filterType) =>
      filterInputs
        .filter((input) => input.dataset.filterType === filterType && input.checked)
        .map((input) => input.value);

    const applyFilters = () => {
      const selectedCategories = getSelectedValues('category');
      const selectedPublishers = getSelectedValues('publisher');
      let visibleCount = 0;

      for (const card of gameCards) {
        const cardCategory = card.dataset.gameCategory || '';
        const cardPublisher = card.dataset.gamePublisher || '';
        const categoryMatches = selectedCategories.length === 0 || selectedCategories.includes(cardCategory);
        const publisherMatches = selectedPublishers.length === 0 || selectedPublishers.includes(cardPublisher);
        const shouldShow = categoryMatches && publisherMatches;

        card.hidden = !shouldShow;
        if (shouldShow) {
          visibleCount += 1;
        }
      }

      if (emptyState) {
        const hasNoMatches = visibleCount === 0;
        emptyState.hidden = !hasNoMatches;
      }
    };

    filterInputs.forEach((input) => input.addEventListener('change', applyFilters));

    clearFiltersButton?.addEventListener('click', () => {
      filterInputs.forEach((input) => {
        input.checked = false;
      });
      applyFilters();
    });

    applyFilters();
  </script>
</Layout>
